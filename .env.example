# Meetup GraphQL endpoint
MEETUP_ENDPOINT=https://api.meetup.com/gql-ext # GraphQL API endpoint — change only if Meetup updates the URL

# Authentication mode: access-token, jwt-bearer, refresh-token
MEETUP_AUTH_MODE=jwt-bearer # Authentication mode: access-token | jwt-bearer | refresh-token

# Debug token mode
MEETUP_ACCESS_TOKEN= # Direct bearer token (access-token mode only) — short-lived, for debugging

# OAuth JWT bearer mode
MEETUP_CLIENT_KEY= # OAuth client key string from your Meetup OAuth application
MEETUP_AUTHORIZED_MEMBER_ID= # Numeric member ID of the Meetup member authorizing the OAuth client
MEETUP_SIGNING_KEY_ID= # Identifier of the RSA key pair registered with your OAuth application
MEETUP_PRIVATE_KEY_PATH=./secrets/meetup-private-key.pem # Path to RSA private key PEM file (must be chmod 600, never commit)

# OAuth refresh token mode
MEETUP_CLIENT_SECRET= # OAuth client secret (refresh-token mode only)
MEETUP_REFRESH_TOKEN_FILE=./secrets/meetup-refresh-token.txt # Path to file storing the current refresh token (single-use, auto-updated)
